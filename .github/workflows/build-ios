name: Build iOS IPA

on:
  workflow_dispatch:
  push:
    branches: [master, main]

jobs:
  build:
    runs-on: macos-14
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive

      # Shows which Xcode projects/schemes exist, so you can fix the names below
      - name: Inspect project
        run: |
          find . -maxdepth 3 -name "*.xcodeproj"
          for p in $(find . -maxdepth 3 -name "*.xcodeproj"); do
            xcodebuild -list -project "$p" || true
          done

      - name: Build (unsigned)
        run: |
          xcodebuild \
            -project RSDKv4.xcodeproj \
            -scheme RSDKv4 \
            -configuration Release \
            -sdk iphoneos \
            -derivedDataPath build \
            CODE_SIGNING_ALLOWED=NO \
            CODE_SIGNING_REQUIRED=NO \
            CODE_SIGN_IDENTITY=""

      - name: Package IPA
        run: |
          mkdir Payload
          cp -R build/Build/Products/Release-iphoneos/*.app Payload/
          zip -r RSDKv4.ipa Payload

      - uses: actions/upload-artifact@v4
        with:
          name: RSDKv4-ios-ipa
          path: RSDKv4.ipa
